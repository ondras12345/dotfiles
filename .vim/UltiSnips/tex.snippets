snippet \beg "begin{} / end{}" b
\begin{$1}
	$0
\end{$1}
endsnippet

snippet \b "begin{} / end{}" b
\begin{$1}
	$0
\end{$1}
endsnippet

snippet fig
\begin{figure}[htbp]
	\centering
	\missingfigure{$1}
	\caption{$0}
	\label{fig:$2}
	\todo[inline]{odkaz z textu}
\end{figure}
endsnippet

snippet tab "table" b
\begin{table}[htbp]
	\centering
	\caption{$2}
	\label{tab:$1}
	\todo[inline]{odkaz z textu}
	$0
\end{table}
endsnippet

snippet booktab "booktabs tabular" b
\begin{tabular}{$1}
	\toprule
	$2
	\midrule
	$0
	\bottomrule
\end{tabular}
endsnippet

snippet \includegraphics
\includegraphics[width=\textwidth, height=\textheight, keepaspectratio]{$0}
endsnippet

# either press backspace ^J for inkscapelatex=true
# or ^J for inkscapelatex=false
snippet \includesvg "svg graphics" b
\includesvg[width=\textwidth, height=\textheight, keepaspectratio${1:, inkscapelatex=false}]{$0}
endsnippet

# either press backspace ^J for no label
# or ^J my_label ^J for specified label
snippet eq "numbered equation" b
\begin{equation}${1:\label{eq:${2:name}}}
	$0
\end{equation}
endsnippet

snippet eq*
\begin{equation*}
	$0
\end{equation*}
endsnippet

snippet todo
\todo[inline]{$0}
endsnippet

snippet subcaptionblock
\begin{subcaptionblock}{\textwidth}
	\centering
	\missingfigure{$1}
	\caption{$0}
	\label{fig:$2}
	\todo[inline]{odkaz z textu}
\end{subcaptionblock}
endsnippet

snippet subcaptionbox
\subcaptionbox{$0\label{fig:$2}}
    {\missingfigure{$1}}
\par\bigskip
endsnippet

snippet eqref
\eqref{eq:$0}
endsnippet

snippet sec "section" b
\section{$1}
$0
endsnippet

snippet ssec "subsection" b
\subsection{$1}
$0
endsnippet

snippet sssec "subsubsection" b
\subsubsection{$1}
$0
endsnippet

# either press backspace ^J for big sep
# or ^J my_label ^J for nosep
snippet enum "Enumerate" b
\begin{enumerate}${1:[nosep]}
	\item $0
\end{enumerate}
endsnippet

# either press backspace ^J for big sep
# or ^J my_label ^J for nosep
snippet item "Itemize" b
\begin{itemize}${1:[nosep]}
	\item $0
\end{itemize}
endsnippet

snippet desc "Description" b
\begin{description}
	\item[$1] $0
\end{description}
endsnippet

snippet gnuplot "gnuplot plot" b
\begin{gnuplot}[terminal=epslatex, terminaloptions={color dashed size \convertlen{\textwidth},\convertlen{.4\textheight}}]
    load "common.gpi"

    #set format y '$\num[round-mode=places,round-precision=2]{%g}$'
    set xlabel 'TODO $U\,[\unit{\volt}]$'
    set ylabel 'TODO $P\,[\unit{\watt}]$'
    #set xrange [0:1]
    #set xtics .1
    #set mxtics 5
    #set yrange [0:1]
    #set ytics .1
    #set mytics 5
    set key top left # width -5

    plot \
        $0
\end{gnuplot}
endsnippet

snippet preamble:basic "basic document template" b
\documentclass[a4paper,11pt]{article}
