[user]
	email = ondras12345@gmail.com
	name = Ondřej Sluka
[log]
	date = iso8601
	decorate = short
[alias]
	st = status
	olog = log --decorate --oneline --graph
	alog = log --all --decorate --oneline --graph
	sdiff = diff --staged
	sd = sdiff
	d = diff
	bak = !git remote | grep backup- | xargs --no-run-if-empty -L1 git push
[core]
	excludesfile = /home/ondra/.config/git/gitignore_global

# Use `git difftool --tool eps_diff --staged filename
# to diff eps (or pdf) files.
# Tabbed will open with two zathura instances. Use ctrl+shift+h / l to switch
# between tabs.
[difftool "eps_diff"]
	cmd = GDK_BACKEND=x11 tabbed -c zathura $LOCAL $REMOTE -e
